{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
"configurations": [
    {
        "name": "Debug picked .out (gdb)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${input:outFilePath}",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    }
],
"inputs": [
    {
        "id": "outFilePath",
        "type": "promptString",
        "description": "Path to a .out file compiled with -g",
        "default": "${workspaceFolder}/ds/bin/debug/"
    }
]
}

